# Generated by Shipyard from a fixed template (ADR 004). User files are under src/.
FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
# Platform-set, per app: keeps build cache layers from being shared across apps.
ENV SHIPYARD_APP_ID={{.AppID}}
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/tmp \
    PORT=8080 \
    PATH=/opt/venv/bin:$PATH
# Root steps take no user input: strip setuid/setgid bits, create the venv.
RUN find / -xdev -perm /6000 -type f -exec chmod a-s {} + \
    && python -m venv /opt/venv && chown -R 10001:10001 /opt/venv
WORKDIR /app
RUN chown 10001:10001 /app
# Everything below, including package install scripts, runs as the app user.
USER 10001:10001
{{- if .Requirements}}
COPY --chown=10001:10001 src/requirements.txt ./
RUN pip install -r requirements.txt
COPY --chown=10001:10001 src/ ./
{{- else}}
COPY --chown=10001:10001 src/ ./
RUN pip install .
{{- end}}
EXPOSE 8080
CMD {{.Cmd}}
