# Copy to .env and adjust. .env is gitignored. All values here are dummy dev defaults.

# Platform database (used by `make migrate` and the api/migrate roles outside compose)
SHIPYARD_DATABASE_URL=postgres://shipyard:shipyard-dev@localhost:5434/shipyard?sslmode=disable

# HTTP listen address of the api role
SHIPYARD_HTTP_ADDR=:8080

# Hostnames (dev uses *.localhost, see ADR 010)
SHIPYARD_BASE_DOMAIN=shipyard.localhost
SHIPYARD_APPS_DOMAIN=apps.localhost

# docker compose
POSTGRES_PASSWORD=shipyard-dev
APPS_DB_PASSWORD=apps-db-dev
