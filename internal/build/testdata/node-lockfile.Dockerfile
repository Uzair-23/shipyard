# Generated by Shipyard from a fixed template (ADR 004). User files are under src/.
FROM node:22-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee
# Platform-set, per app: keeps build cache layers from being shared across apps,
# and labels every intermediate image so failed builds can be cleaned up per app.
LABEL shipyard.app_id=0b5f0b4e-6f1a-4c8e-9d7a-2f3e4d5c6b7a
ENV SHIPYARD_APP_ID=0b5f0b4e-6f1a-4c8e-9d7a-2f3e4d5c6b7a
ENV NODE_ENV=production \
    HOME=/tmp \
    PORT=8080 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false
# Root steps take no user input: strip setuid/setgid bits.
RUN find / -xdev -perm /6000 -type f -exec chmod a-s {} +
WORKDIR /app
RUN chown 10001:10001 /app
# Everything below, including package install scripts, runs as the app user.
USER 10001:10001
COPY --chown=10001:10001 src/package.json src/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --chown=10001:10001 src/ ./
EXPOSE 8080
CMD ["/bin/sh","-c","exec npm start"]
