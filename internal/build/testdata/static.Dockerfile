# Generated by Shipyard from a fixed template (ADR 004). User files are under src/.
FROM caddy:2-alpine@sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0
# Platform-set, per app: keeps build cache layers from being shared across apps,
# and labels every intermediate image so failed builds can be cleaned up per app.
LABEL shipyard.app_id=0b5f0b4e-6f1a-4c8e-9d7a-2f3e4d5c6b7a
ENV SHIPYARD_APP_ID=0b5f0b4e-6f1a-4c8e-9d7a-2f3e4d5c6b7a
ENV HOME=/tmp \
    XDG_CONFIG_HOME=/tmp/caddy/config \
    XDG_DATA_HOME=/tmp/caddy/data \
    PORT=8080
# Root steps take no user input: strip setuid/setgid bits, write a fixed
# Caddyfile (admin API off, dotfiles such as .env and .git never served).
RUN find / -xdev -perm /6000 -type f -exec chmod a-s {} + \
    && printf '%s\n' '{' '	admin off' '	auto_https off' '}' ':8080 {' '	root * /srv' '	file_server {' '		hide .*' '	}' '}' > /etc/caddy/Caddyfile
USER 10001:10001
# Files stay root-owned: the app user can read but not modify them.
COPY src/ /srv/
EXPOSE 8080
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
